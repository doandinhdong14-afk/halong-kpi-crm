# Chuỗi kết nối PostgreSQL. Dev: chạy `npm run db:start` (Postgres nhúng, cổng 5433).
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/crm_kpi_v14"
# Khóa ký cookie phiên đăng nhập (chuỗi ngẫu nhiên >= 32 ký tự).
AUTH_SECRET="doi-thanh-chuoi-ngau-nhien-dai"
# Thư mục lưu file minh chứng / giấy tờ. Railway: /data/uploads (Volume gắn ở /data).
UPLOAD_DIR="./uploads"
# Bí mật cho endpoint cron: gửi header "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET="doi-thanh-chuoi-ngau-nhien"
TZ="Asia/Ho_Chi_Minh"
# Chỉ cho service cron trên Railway: URL công khai của app (vd https://crm-kpi.up.railway.app).
APP_URL=""
